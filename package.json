{
  "name": "@neatico/generation-jobs",
  "version": "0.2.3",
  "description": "Versioned, conflict-aware checkpoints for recoverable generation workflows.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/cjs.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm test"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "homepage": "https://www.neatico.com/?utm_source=npm&utm_medium=package&utm_campaign=generation-jobs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neatico/generation-jobs.git"
  },
  "bugs": {
    "url": "https://github.com/neatico/generation-jobs/issues"
  },
  "author": {
    "name": "POWERDUCK LIMITED",
    "url": "https://www.neatico.com/"
  },
  "keywords": [
    "checkpoint",
    "resume",
    "retry",
    "idempotent",
    "recoverable",
    "generation",
    "workflow",
    "ai",
    "neatico"
  ]
}
